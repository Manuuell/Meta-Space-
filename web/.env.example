# Copia este archivo como .env.local (no se sube a git) o define las
# variables en el panel de tu hosting.

# Clave de Meta Model API. Sin ella el juego funciona entero con el guion local.
MODEL_API_KEY=

# En un servidor público: escuchar en todas las interfaces. Si la plataforma
# define PORT, ya se escucha en 0.0.0.0 sin tocar esto.
# HOST=0.0.0.0
# PORT=8787

# Detrás de un proxy (Render, Railway, Fly, nginx): IP real del cliente para
# los límites de peticiones.
# TRUST_PROXY=1

# Otros dominios que pueden llamar a la API (el propio dominio siempre puede).
# ALLOWED_ORIGINS=https://meta-space.example

# Llamadas de pago al día antes de pasar a modo local.
# AI_DAILY_LIMIT=1500
